# VPS site template (used only when deploy/TARGET is vps; scripts/instantiate.py fills <slug> and <domain>).
# It serves the build exactly as GitHub Pages would (T15 of the 2026-10-04 base requirements):
#   - every route is a materialised directory (frontend/scripts/materialize-routes.mjs), so there is no SPA
#     fallback: a missing artifact or an unknown route answers 404 with the app's own 404.html, instead of the app
#     answering for a file that does not exist;
#   - the MIME table is included before any extra type (a server-level `types {}` block replaces the whole table,
#     and every .js would be served as octet-stream);
#   - the dormant API (app/), when activated, sits behind /api/ with a keepalive pool below the app server's.
upstream fasl_<slug>_api {
    server 127.0.0.1:<port>;
    keepalive 8;
}

server {
    server_name <domain>;
    listen 80;

    root /opt/fasl-<slug>/frontend/dist;
    include /etc/nginx/mime.types;
    error_page 404 /404.html;

    location /data/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /build.json {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /api/ {
        proxy_pass http://fasl_<slug>_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}
